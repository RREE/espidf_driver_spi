with "config/espidf_driver_spi_config.gpr";

with "espidf.gpr";

library project ESPIDF_Driver_SPI is

   for Languages use ("Ada", "C");
   for Library_Name use "espidf_driver_spi";
   for Library_Dir use ESPIDF.Crate_Library_Dir;
   for Object_Dir use ESPIDF.Crate_Object_Dir;
   for Source_Dirs use ("source");

   package Compiler extends ESPIDF.Compiler is
   end Compiler;

end ESPIDF_Driver_SPI;
